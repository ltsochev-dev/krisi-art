DATABASE_URL=file:./database/krisi-dba.sqlite
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public origin of this app. Used to build the Cognito redirect and sign-out
# URLs, so it must match what a browser actually hits (not the container host).
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AWS Cognito — the only identity provider this backend trusts.
#
# Payload's local password login is disabled entirely: /api/users/login,
# forgot-password, reset-password, verify and create-first-user all reject.
#
# App client setup (Cognito console -> App client -> Login pages):
#   Allowed callback URL:   ${APP_URL}/api/auth/cognito/callback
#   Allowed sign-out URL:   ${APP_URL}/admin/login
#   OAuth grant type:       Authorization code grant
#   OpenID Connect scopes:  openid, email, profile
# ---------------------------------------------------------------------------
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
COGNITO_CLIENT_ID=YOUR_APP_CLIENT_ID
# Only for confidential app clients ("Generate a client secret" enabled).
# Leave empty for a public client — PKCE is always used either way.
COGNITO_CLIENT_SECRET=
# Hosted UI domain, with or without the scheme. Either the Cognito prefix
# domain or your own custom domain.
COGNITO_DOMAIN=your-prefix.auth.eu-central-1.amazoncognito.com

# Cognito group -> Payload role. Membership in none of these denies access and
# no local user record is created. At least COGNITO_ADMIN_GROUP is required.
COGNITO_ADMIN_GROUP=payload-admins
COGNITO_EDITOR_GROUP=payload-editors

# Optional overrides — only set these if the defaults derived from APP_URL are
# not what you registered on the app client.
# COGNITO_REDIRECT_URI=
# COGNITO_LOGOUT_REDIRECT_URI=
# COGNITO_SCOPES="openid email profile"

# ---------------------------------------------------------------------------
# AWS S3. Deployed as a container on a VPS, so there is no instance role —
# static keys are expected. If both are omitted, the default AWS provider chain
# is used instead.
# ---------------------------------------------------------------------------
S3_REGION=eu-central-1
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# For S3-compatible providers (MinIO, R2, Spaces).
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Resend (email). Leave RESEND_API_KEY unset to log emails instead of sending them.
RESEND_API_KEY=YOUR_KEY_HERE
RESEND_FROM_ADDRESS=contacts@kristinakostova.com
RESEND_FROM_NAME="Kristina Kostova"
# Non-production only: route every outgoing email to this address instead.
RESEND_OVERRIDE_RECIPIENT=

# Where contact form submissions are emailed. Normally set per-site in the admin
# under Settings -> Contact Page -> Form -> Recipients; this is only the fallback
# when that list is empty, and it in turn falls back to RESEND_FROM_ADDRESS.
# Submissions are always stored in the Inbox regardless of whether email works.
# CONTACT_NOTIFY_EMAIL=
