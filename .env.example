DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Resend (email). Leave RESEND_API_KEY unset to log emails instead of sending them.
RESEND_API_KEY=YOUR_KEY_HERE
RESEND_FROM_ADDRESS=contacts@kristinakostova.com
RESEND_FROM_NAME="Kristina Kostova"
# Non-production only: route every outgoing email to this address instead.
RESEND_OVERRIDE_RECIPIENT=
